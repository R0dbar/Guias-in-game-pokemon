@@ -7,6 +7,9 @@
 
 #define MULTI_B_PRESSED  127
 
+// Índice en gMultichoiceLists (src/script_menu.c), que no tiene constantes: va justo después de la 72.
+#define MULTI_GUIDE_LANGUAGE 73
+
 // Multichoice Ids
 // TODO
 
diff --git a/include/guide.h b/include/guide.h
index 7d6e7b640..b00404a18 100644
--- a/include/guide.h
+++ b/include/guide.h
@@ -6,4 +6,14 @@ enum { GUIDE_LANG_EN, GUIDE_LANG_ES, GUIDE_LANG_COUNT };
 // Deja en gStringVar4 el objetivo y el destino del primer paso pendiente, o el texto de fin.
 void Guide_BufferCurrentStep(u8 lang);
 
+// Special de EventScript_Guide: idioma = opción elegida en el multichoice (VAR_RESULT).
+void Guide_BufferCurrentStepFromResult(void);
+
+extern const u8 gText_MenuGuide[];
+extern const u8 gText_GuideEnglish[];
+extern const u8 gText_GuideSpanish[];
+
+// Selector de idioma del menú Start (data/scripts/guide.inc); pokeruby no tiene event_scripts.h.
+extern const u8 EventScript_Guide[];
+
 #endif // GUARD_GUIDE_H
diff --git a/src/guide.c b/src/guide.c
index 4e6e7aab5..71d7eaff3 100644
--- a/src/guide.c
+++ b/src/guide.c
@@ -51,3 +51,13 @@ void Guide_BufferCurrentStep(u8 lang)
     }
     StringCopy(gStringVar4, sGuideEndText[lang]);
 }
+
+const u8 gText_MenuGuide[] = _("GUIDE");
+const u8 gText_GuideEnglish[] = _("ENGLISH");
+const u8 gText_GuideSpanish[] = _("ESPAÑOL");
+
+// El orden de MultichoiceList_GuideLanguage coincide con el enum de idiomas.
+void Guide_BufferCurrentStepFromResult(void)
+{
+    Guide_BufferCurrentStep(gSpecialVar_Result);
+}
