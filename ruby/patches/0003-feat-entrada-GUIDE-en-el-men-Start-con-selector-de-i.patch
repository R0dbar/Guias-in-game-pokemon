diff --git a/data/scripts/guide.inc b/data/scripts/guide.inc
new file mode 100644
index 000000000..571765bf1
--- /dev/null
+++ b/data/scripts/guide.inc
@@ -0,0 +1,10 @@
+EventScript_Guide::
+	lockall
+	multichoice 0, 0, MULTI_GUIDE_LANGUAGE, 0
+	compare VAR_RESULT, MULTI_B_PRESSED
+	goto_if_eq EventScript_GuideEnd
+	special Guide_BufferCurrentStepFromResult
+	msgbox gStringVar4, MSGBOX_DEFAULT
+EventScript_GuideEnd:
+	releaseall
+	end
