diff --git a/src/guide.c b/src/guide.c
new file mode 100644
index 000000000..4e6e7aab5
--- /dev/null
+++ b/src/guide.c
@@ -0,0 +1,53 @@
+#include "global.h"
+#include "guide.h"
+#include "event_data.h"
+#include "string_util.h"
+#include "text.h"
+#include "constants/flags.h"
+#include "constants/vars.h"
+
+// Arrays fijos, como .name de los objetos: agbcc no acepta (const u8[])_("...") con texto.
+// shortcut: cada texto ocupa GUIDE_TEXT_LEN bytes aunque sea corto; si la ROM se queda sin sitio, pasar a arrays con nombre.
+// Un texto más largo hace fallar la compilación ("excess elements in array initializer").
+// gStringVar4 mide 256 bytes en Rubí: objetivo + \p + destino + {PAUSE_UNTIL_PRESS} de los objetos + fin
+// ocupan como mucho 126 + 1 + 126 + 2 + 1 = 256.
+#define GUIDE_TEXT_LEN 127
+
+struct GuideStep {
+    u16 doneFlag;      // se usa si doneVar == 0
+    u16 doneVar;       // si no es 0: completado cuando VarGet(doneVar) >= doneVarMin (las vars empiezan en 0x4000)
+    u16 doneVarMin;
+    u8 objective[GUIDE_LANG_COUNT][GUIDE_TEXT_LEN];
+    u8 location[GUIDE_LANG_COUNT][GUIDE_TEXT_LEN];
+};
+
+#include "data/guide_steps.h"
+
+static const u8 sText_NextBox[] = _("\p");
+
+static bool8 IsStepDone(const struct GuideStep *step)
+{
+    if (step->doneVar != 0)
+        return VarGet(step->doneVar) >= step->doneVarMin;
+    return FlagGet(step->doneFlag);
+}
+
+void Guide_BufferCurrentStep(u8 lang)
+{
+    u32 i;
+
+    if (lang >= GUIDE_LANG_COUNT)
+        lang = GUIDE_LANG_EN;
+
+    for (i = 0; i < ARRAY_COUNT(sGuideSteps); i++)
+    {
+        if (!IsStepDone(&sGuideSteps[i]))
+        {
+            StringCopy(gStringVar4, sGuideSteps[i].objective[lang]);
+            StringAppend(gStringVar4, sText_NextBox);
+            StringAppend(gStringVar4, sGuideSteps[i].location[lang]);
+            return;
+        }
+    }
+    StringCopy(gStringVar4, sGuideEndText[lang]);
+}
