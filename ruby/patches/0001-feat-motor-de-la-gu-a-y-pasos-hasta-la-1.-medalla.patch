+// Pasos de la guía (PoC: hasta la 1.ª medalla). Junto a cada paso, el script donde el juego cumple su condición.
+// tools/check_guide.py lee este formato: cada texto como _("..."), EN y luego ES.
+
+static const struct GuideStep sGuideSteps[] =
+{
+    {
+        .doneFlag = FLAG_RESCUED_BIRCH, // data/maps/Route101/scripts.inc:221
+        .objective = {
+            [GUIDE_LANG_EN] = _("Help PROF. BIRCH."),
+            [GUIDE_LANG_ES] = _("Ayuda a PROF. BIRCH\n(Prof. Abedul)."),
+        },
+        .location = {
+            [GUIDE_LANG_EN] = _("Go to ROUTE 101, north of\nLITTLEROOT TOWN."),
+            [GUIDE_LANG_ES] = _("Ve a ROUTE 101 (Ruta 101), al norte\nde LITTLEROOT TOWN (Villa Raíz)."),
+        },
+    },
+    {
+        .doneFlag = FLAG_DEFEATED_RIVAL_ROUTE103, // data/maps/Route103/scripts.inc:123
+        .objective = {
+            [GUIDE_LANG_EN] = _("Find your rival and battle."),
+            [GUIDE_LANG_ES] = _("Busca a tu rival y lucha contra él."),
+        },
+        .location = {
+            [GUIDE_LANG_EN] = _("Go to ROUTE 103, north of\nOLDALE TOWN."),
+            [GUIDE_LANG_ES] = _("Ve a ROUTE 103 (Ruta 103), al norte\nde OLDALE TOWN (Pueblo Escaso)."),
+        },
+    },
+    {
+        .doneFlag = FLAG_SYS_POKEDEX_GET, // data/maps/LittlerootTown_ProfessorBirchsLab/scripts.inc:160
+        .objective = {
+            [GUIDE_LANG_EN] = _("Get the POKéDEX from PROF. BIRCH."),
+            [GUIDE_LANG_ES] = _("Recoge la POKéDEX que te da\nPROF. BIRCH (Prof. Abedul)."),
+        },
+        .location = {
+            [GUIDE_LANG_EN] = _("Go back to PROF. BIRCH's LAB in\nLITTLEROOT TOWN."),
+            [GUIDE_LANG_ES] = _("Vuelve a su laboratorio en\nLITTLEROOT TOWN (Villa Raíz)."),
+        },
+    },
+    {
+        .doneVar = VAR_PETALBURG_GYM_STATE, // 2 = fin del tutorial de WALLY, data/maps/PetalburgCity_Gym/scripts.inc:86
+        .doneVarMin = 2,
+        .objective = {
+            [GUIDE_LANG_EN] = _("Visit your dad, NORMAN, and\nhelp WALLY."),
+            [GUIDE_LANG_ES] = _("Visita a tu padre, NORMAN, y\nayuda a WALLY (Blasco)."),
+        },
+        .location = {
+            [GUIDE_LANG_EN] = _("Go to the PETALBURG CITY GYM.\pTake ROUTE 102 west from\nOLDALE TOWN."),
+            [GUIDE_LANG_ES] = _("Ve al gimnasio de PETALBURG CITY\n(Ciudad Petalia).\pSigue ROUTE 102 (Ruta 102) al oeste\nde OLDALE TOWN (Pueblo Escaso)."),
+        },
+    },
